# พอร์ตของเว็บ
PORT=3000
# รหัสผ่านเข้าหน้าเว็บ (เว้นว่าง = ไม่ล็อก)  ชื่อผู้ใช้คือ admin
ADMIN_PASSWORD=
# จาก LINE Developers Console > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ไม่ต้องใส่ก็ได้: เชิญบอทเข้ากลุ่มแล้วพิมพ์ "ตั้งกลุ่มนี้" ระบบจะจำให้เอง
LINE_GROUP_ID=
# ไฟล์ฐานข้อมูล
DB_PATH=./data.db
TZ=Asia/Bangkok
# ---- เชื่อมกับเว็บไซต์ (apps/web) ----
# คีย์ลับที่เว็บไซต์ใช้ส่งออเดอร์เข้าคิว (ตั้งให้ตรงกับ PRINT_QUEUE_API_KEY ของเว็บ) สร้างด้วย: openssl rand -hex 32
INTEGRATION_API_KEY=
# โฟลเดอร์เก็บไฟล์ STL ที่ลูกค้าอัปโหลด
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
